    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.token) { pm.collectionVariables.set('authToken', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"darksyntax\",\n  \"password\": \"<admin-password>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/staff-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "staff-login"]
            },
            "description": "Admin/teacher sign-in by email or username. Returns a Supabase JWT. Rate limited (20/60s per IP); account locks for 15 minutes after 5 failed attempts. Returns 503 when Supabase is not configured."
          },
          "response": []
        },
        {
          "name": "POST Learner Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.token) { pm.collectionVariables.set('learnerToken', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentNumber\": \"GMA-2026-0301\",\n  \"pin\": \"0000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/learner-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "learner-login"]
            },
            "description": "Learner sign-in with student number and 4-digit PIN. Returns a locally-signed JWT (12h). Rate limited (10/60s per IP); account locks for 15 minutes after 5 failed attempts."
          },
          "response": []
        },
        {
          "name": "GET Current User",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns the authenticated principal ({ id, role, email?, studentNumber?, name?, schoolId?, classId?, grade?, assignedClasses?, assignedSubjects? }). Requires a Bearer token."
          },
          "response": []
        }
      ]
    },
