    {
      "name": "Quizzes",
      "item": [
        {
          "name": "GET Quizzes",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes"]
            },
            "description": "Role-aware quiz list. Learners receive published/closed/released quizzes that are class-eligible, with correctAnswer and explanation stripped. Returns { quizzes: Quiz[] }."
          },
          "response": []
        },
        {
          "name": "GET Quiz by ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}"]
            },
            "description": "Single quiz. Enforces school boundary, teacher ownership/allocation, and learner visibility (draft or class-ineligible => 403). Answers stripped for learners unless results are released and they have a submission. Returns { quiz }."
          },
          "response": []
        },
        {
          "name": "POST Create Quiz (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grade 3 Fractions\",\n  \"grade\": \"Grade 3\",\n  \"classId\": \"cls-3a\",\n  \"className\": \"Grade 3A\",\n  \"subjectId\": \"subj-math\",\n  \"subjectName\": \"Mathematics\",\n  \"topicsCovered\": [\"Fractions\"],\n  \"learningObjectives\": \"Understand halves and quarters.\",\n  \"difficulty\": \"medium\",\n  \"durationMinutes\": 15,\n  \"instructions\": \"Answer all questions carefully.\",\n  \"status\": \"draft\",\n  \"releasePolicy\": \"manual\",\n  \"allowOffline\": true,\n  \"maxAttempts\": 1,\n  \"questions\": [\n    {\n      \"id\": \"q1\",\n      \"type\": \"multiple_choice\",\n      \"prompt\": \"What is 1/2 of 4?\",\n      \"options\": [\n        { \"id\": \"a\", \"text\": \"2\" },\n        { \"id\": \"b\", \"text\": \"3\" }\n      ],\n      \"correctAnswer\": \"a\",\n      \"marks\": 2,\n      \"topic\": \"Fractions\",\n      \"explanation\": \"Half of 4 is 2.\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes"]
            },
            "description": "Create an assessment (title/grade/classId required). Questions are strictly validated when status is published/in_progress. 201 returns { quiz }."
          },
          "response": []
        },
        {
          "name": "PUT Update Quiz (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grade 3 Fractions (revised)\",\n  \"durationMinutes\": 20,\n  \"difficulty\": \"hard\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}"]
            },
            "description": "Update a quiz. Questions are locked once submissions exist. Teachers may only edit their own assessments. 200 returns { quiz }."
          },
          "response": []
        },
        {
          "name": "POST Publish Quiz (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "publish"]
            },
            "description": "Publish a quiz to its cohort (status -> in_progress). Validates questions and requires a classId. 200 returns { quiz, message }."
          },
          "response": []
        },
        {
          "name": "POST Close Quiz (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "close"]
            },
            "description": "Close a quiz (status -> closed) so learners cannot submit new attempts. 200 returns { quiz, message }."
          },
          "response": []
        },
        {
          "name": "POST Assign Quiz (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": \"cls-3b\",\n  \"className\": \"Grade 3B\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "assign"]
            },
            "description": "Assign a quiz to a class cohort (classId required). 200 returns { quiz, message }."
          },
          "response": []
        },
        {
          "name": "DELETE Delete Quiz (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}"]
            },
            "description": "Delete a quiz. Blocked with 400 when learner submissions exist. Teachers may only delete their own. 200 returns { success, message }."
          },
          "response": []
        },
        {
          "name": "GET Quiz Submissions (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "submissions"]
            },
            "description": "List all submissions for a quiz. Returns { quizId, quizTitle, totalSubmissions, submissions }."
          },
          "response": []
        },
        {
          "name": "POST Release Results (Admin/Teacher)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": {
