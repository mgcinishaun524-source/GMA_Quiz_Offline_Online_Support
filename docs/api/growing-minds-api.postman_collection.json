{
  "info": {
    "_postman_id": "b7f1c2a4-0d3e-4f5b-9a6c-growingminds01",
    "name": "Growing Minds Academy API",
    "description": "REST API for the Growing Minds Academy assessment platform (Express backend in server.ts / api/index.ts).\n\nAuthentication: staff sign in via POST /api/auth/staff-login (Supabase JWT); learners via POST /api/auth/learner-login (locally-signed JWT). Send the returned token as a Bearer token via the {{authToken}} collection variable.\n\nEvery data route fails closed with 503 when Supabase is not configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{authToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "learnerToken", "value": "", "type": "string" },
    { "key": "quizId", "value": "quiz-1730000000000-ab12", "type": "string" },
    { "key": "learnerId", "value": "GMA-2026-0301", "type": "string" },
    { "key": "submissionId", "value": "sub-1730000000001-xy99", "type": "string" },
    { "key": "teacherId", "value": "30000000-0000-0000-0000-0000000000aa", "type": "string" },
    { "key": "classId", "value": "cls-3a", "type": "string" },
    { "key": "subjectId", "value": "subj-math", "type": "string" }
  ],
  "item": [
    {
