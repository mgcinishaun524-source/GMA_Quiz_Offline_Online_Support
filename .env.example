# ============================================================================
# Growing Minds Academy — Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AI QUIZ GENERATION (Google Gemini API)
# ----------------------------------------------------------------------------
# Required for server-side pedagogical question drafting.
# In AI Studio Build, this is automatically injected at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The public base URL where this applet is hosted.
APP_URL="https://your-applet-url.run.app"

# ----------------------------------------------------------------------------
# 2. PERSISTENT SUPABASE POSTGRESQL BACKEND
# ----------------------------------------------------------------------------
# Obtain all values from: Supabase Dashboard -> Project Settings -> API Keys
#   * Project URL                -> SUPABASE_URL / VITE_SUPABASE_URL
#   * Publishable (legacy: anon public) key -> VITE_SUPABASE_ANON_KEY
#   * Secret   (legacy: service_role)  key -> SUPABASE_SERVICE_ROLE_KEY
#
# Server-Side Only (NEVER expose to browser bundles, client code, logs or git)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Client-Side Safe (publishable / legacy anon key only — this one is public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_JWT_SECRET — local session-signing secret for LEARNER tokens.
# The backend signs learner session tokens (student number + PIN logins) with this
# value and verifies them on every request. Supabase-issued STAFF tokens are
# validated through Supabase Auth (auth.getUser) and do NOT use this secret.
#
# - It must be a strong random signing secret. Generate one, e.g.:
#       node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# - Do NOT paste the project URL, publishable/anon key, service-role/secret key,
#   or project ref here. It does not need to match Supabase's project JWT secret.
# - Required in production (NODE_ENV=production): the server fails closed
#   (refuses to sign/verify learner tokens) if it is missing. In development
#   and test an ephemeral per-process secret is generated automatically.

# ----------------------------------------------------------------------------
# 2b. INITIAL ADMINISTRATOR BOOTSTRAP (SERVER-ONLY)
# ----------------------------------------------------------------------------
# The initial administrator is created idempotently on server startup from the
# INITIAL_ADMIN_PASSWORD value below. The username is fixed as "darksyntax".
#
# - Set this ONLY in your local .env or the hosting provider's secret manager.
# - NEVER commit the real password here; leave the placeholder in source control.
# - If this variable is unset or under 8 characters, no administrator is
#   provisioned and the server reports that clearly (existing accounts are
#   never overwritten).
# - To rotate/reset the password: set a new value, delete the existing
#   darksyntax account row in Supabase (auth + user_profiles), then restart.
INITIAL_ADMIN_PASSWORD=""
# Optional: override the admin email (defaults to darksyntax@gma.edu).
# INITIAL_ADMIN_EMAIL="darksyntax@gma.edu"

# ----------------------------------------------------------------------------
# 3. APPLICATION OPERATIONAL MODES & CONTROLS
# ----------------------------------------------------------------------------
# Demo / mock authentication and in-memory sample data have been removed.
# Supabase is the sole authority for online data; the server fails closed (503)
# whenever the database is unavailable.
#
# A. Real-User Testing / Production Mode with a Verified Database Connection:
#    VITE_APP_MODE="production"
#    ALLOW_DEMO_AUTH="false"
#    SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY configured with live credentials.
#    - All quiz lifecycle operations, submissions, and audit events persist to PostgreSQL.
#    - Staff authenticate through Supabase Auth; learners authenticate via salted bcrypt PINs.
#    - No demo accounts, no role switching, no fabricated records.
#
# B. Database Unavailable:
#    If SUPABASE_URL is unconfigured or the database connection fails, the server
#    strictly returns HTTP 503 Service Unavailable ("Production storage is
#    unavailable. Database connection required."). The system does NOT silently
#    fall back to mock data, so a failed save can never be reported as success.
#    Offline tablet support is preserved on the client (IndexedDB caching and a
#    queued submission sync), but it only ever stores and replays real records.
# ----------------------------------------------------------------------------
VITE_APP_MODE="production"
ALLOW_DEMO_AUTH="false"
